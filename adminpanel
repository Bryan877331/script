local function clearContent()

	for _, object in ipairs(Content:GetChildren()) do

		if not object:IsA("UIListLayout")
			and not object:IsA("UIPadding") then

			object:Destroy()
		end
	end
end

local function makeButton(text, callback)

	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1, -5, 0, 40)
	Button.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
	Button.BorderSizePixel = 0

	Button.Text = text
	Button.TextColor3 = Color3.fromRGB(235, 235, 240)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamMedium

	Button.Parent = Content

	Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)

	Button.MouseEnter:Connect(function()
		Button.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
	end)

	Button.MouseLeave:Connect(function()
		Button.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
	end)

	Button.MouseButton1Click:Connect(callback)

	return Button
end

local function makeToggle(text, initial, callback)

	local enabled = initial

	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1, -5, 0, 40)
	Button.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
	Button.BorderSizePixel = 0

	Button.TextColor3 = Color3.fromRGB(235, 235, 240)
	Button.TextSize = 13
	Button.Font = Enum.Font.GothamMedium

	Button.Parent = Content

	Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)

	local function update()

		Button.Text = text .. "     [" ..
			(enabled and "ON" or "OFF") ..
			"]"

		if enabled then
			Button.BackgroundColor3 = Color3.fromRGB(45, 75, 52)
		else
			Button.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
		end
	end

	update()

	Button.MouseButton1Click:Connect(function()

		enabled = not enabled

		update()
		callback(enabled)
	end)

	return Button
end

local function makeSection(text)

	local Label = Instance.new("TextLabel")

	Label.Size = UDim2.new(1, -5, 0, 30)
