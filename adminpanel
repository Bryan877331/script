--==================================================
-- CONFIG
--==================================================

-- Add UserIds here for hardcoded admins (optional — only used if RESTRICT_ADMINS is true)
local ADMIN_USERIDS = {
	-- [123456789] = true,
}

-- OR grant admin via a group + minimum rank (set GROUP_ID to 0 to disable)
local ADMIN_GROUP_ID = 0
local ADMIN_MIN_RANK = 200

-- Set this to true once you've filled in ADMIN_USERIDS / the group settings above.
-- While false, EVERY player who joins gets the panel — fine for solo testing in
-- Studio, but flip this on before publishing so randoms can't kick/ban/god-mode
-- everyone in your game.
local RESTRICT_ADMINS = false

local function isAdmin(player)
	if not RESTRICT_ADMINS then
		return true
	end
	if ADMIN_USERIDS[player.UserId] then
		return true
	end
	if ADMIN_GROUP_ID ~= 0 then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(ADMIN_GROUP_ID)
		end)
		if ok and rank >= ADMIN_MIN_RANK then
			return true
		end
	end
	return false
end

--==================================================
-- STATE
--==================================================

-- Per-player state tables, keyed by Player instance
local PlayerState = {} -- [Player] = { frozen, god, noclip, fly, muted, walkspeed, jumppower }

local MutedPlayers = {} -- [UserId] = true
local BannedUserIds = {} -- [UserId] = { reason = "...", by = "AdminName" } (session-only; use DataStore for persistence)

local function getState(player)
	if not PlayerState[player] then
		PlayerState[player] = {
			frozen = false,
			god = false,
			noclip = false,
			fly = false,
			muted = false,
			walkspeed = 16,
			jumppower = 50,
		}
	end
	return PlayerState[player]
end

--==================================================
-- CHARACTER HELPERS
--==================================================

local function getParts(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid, root
end

local function healPlayer(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = humanoid.MaxHealth
	end
end

local function killPlayer(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Health = 0
	end
end

local function kickPlayer(player, reason)
	player:Kick("[ADMIN] Kicked. Reason: " .. (reason or "No reason given"))
end

local function banPlayer(player, reason, adminName)
	BannedUserIds[player.UserId] = { reason = reason or "No reason given", by = adminName }
	player:Kick("[ADMIN] Banned. Reason: " .. (reason or "No reason given"))
end

local function freezePlayer(player, frozen)
	local state = getState(player)
	state.frozen = frozen
	local humanoid, root = getParts(player.Character)
	if humanoid then
		humanoid.WalkSpeed = frozen and 0 or state.walkspeed
		humanoid.JumpPower = frozen and 0 or state.jumppower
	end
	if root then
		root.Anchored = frozen
	end
end

local function setGod(player, enabled)
	local state = getState(player)
	state.god = enabled
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.MaxHealth = enabled and math.huge or 100
		if enabled then
			humanoid.Health = humanoid.MaxHealth
		else
			humanoid.MaxHealth = 100
			humanoid.Health = 100
		end
	end
end

local function setNoclip(player, enabled)
	getState(player).noclip = enabled
end

local function setSpeed(player, value)
	getState(player).walkspeed = value
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = value
	end
end

local function setJump(player, value)
	getState(player).jumppower = value
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = value
	end
end

local function teleportPlayerToPlayer(playerToMove, destinationPlayer)
	local _, root = getParts(playerToMove.Character)
	local _, destRoot = getParts(destinationPlayer.Character)
	if root and destRoot then
		root.CFrame = destRoot.CFrame * CFrame.new(0, 0, 4)
	end
end

local function ragdoll(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		task.delay(3, function()
			if humanoid and humanoid.Parent then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end
end

local SpinningPlayers = {} -- [Player] = true
local LaunchQueue = {} -- one-shot, handled in loop below

--==================================================
-- NOCLIP / FLY LOOP (server authoritative)
--==================================================

RunService.Heartbeat:Connect(function()
	for player, state in pairs(PlayerState) do
		local character = player.Character
		if character then
			if state.noclip then
				for _, object in ipairs(character:GetDescendants()) do
					if object:IsA("BasePart") then
						object.CanCollide = false
					end
				end
			end

			if state.fly then
				local humanoid, root = getParts(character)
				if humanoid and root then
					-- MoveDirection is a client-set property that replicates to the
					-- server automatically, so this works without any LocalScript.
					local moveDir = humanoid.MoveDirection
					if moveDir.Magnitude > 0 then
						root.AssemblyLinearVelocity = moveDir * 60
					else
						root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y * 0.9, 0)
					end
				end
			end

			if SpinningPlayers[player] then
				local _, root = getParts(character)
				if root then
					root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(8), 0)
				end
			end
		end
	end
end)

--==================================================
-- LIGHTING PRESETS
--==================================================

local OriginalLighting = {
	Brightness = Lighting.Brightness,
	ClockTime = Lighting.ClockTime,
	FogEnd = Lighting.FogEnd,
	GlobalShadows = Lighting.GlobalShadows,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

local function applyLightingPreset(name)
	if name == "Fullbright" then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
	elseif name == "Night" then
		Lighting.ClockTime = 0
	elseif name == "Noon" then
		Lighting.ClockTime = 12
	elseif name == "Reset" then
		for property, value in pairs(OriginalLighting) do
			Lighting[property] = value
		end
	end
end

--==================================================
-- CHAT / MODERATION
--==================================================

local function setMuted(player, muted)
	MutedPlayers[player.UserId] = muted or nil
	getState(player).muted = muted
end

local TextChatService = game:GetService("TextChatService")
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	-- New chat system: block muted players via SendingMessage on TextChannels
	TextChatService.ChannelAdded:Connect(function(channel)
		channel.ShouldDeliverCallback = function(message)
			local senderPlayer = Players:GetPlayerByUserId(message.TextSource and message.TextSource.UserId or -1)
			if senderPlayer and MutedPlayers[senderPlayer.UserId] then
				return false
			end
			return true
		end
	end)
end

--==================================================
-- SERVER-WIDE ACTIONS
--==================================================

local function announce(text)
	for _, player in ipairs(Players:GetPlayers()) do
		local playerGui = player:FindFirstChild("PlayerGui")
		if playerGui then
			local existing = playerGui:FindFirstChild("AdminAnnouncement")
			if existing then
				existing:Destroy()
			end

			local gui = Instance.new("ScreenGui")
			gui.Name = "AdminAnnouncement"
			gui.ResetOnSpawn = false
			gui.IgnoreGuiInset = true
			gui.Parent = playerGui

			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 0, 60)
			label.Position = UDim2.new(0, 0, 0, 0)
			label.BackgroundColor3 = Color3.fromRGB(17, 17, 23)
			label.BackgroundTransparency = 0.1
			label.TextColor3 = Color3.fromRGB(240, 240, 245)
			label.TextSize = 20
			label.Font = Enum.Font.GothamBold
			label.Text = "[ANNOUNCEMENT] " .. text
			label.TextWrapped = true
			label.Parent = gui

			task.delay(8, function()
				gui:Destroy()
			end)
		end
	end
end

local function rejoinServer(player)
	TeleportService:Teleport(game.PlaceId, player)
end

