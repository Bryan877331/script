local function onPlayerAdded(player)
	if BannedUserIds[player.UserId] then
		player:Kick("[ADMIN] You are banned. Reason: " .. BannedUserIds[player.UserId].reason)
		return
	end

	getState(player)

	player.CharacterAdded:Connect(function(character)
		task.wait(0.2)
		local state = getState(player)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = state.frozen and 0 or state.walkspeed
			humanoid.UseJumpPower = true
			humanoid.JumpPower = state.frozen and 0 or state.jumppower
			if state.god then
				humanoid.MaxHealth = math.huge
				humanoid.Health = math.huge
			end
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.Anchored = state.frozen
		end
	end)

	if isAdmin(player) then
		buildGuiForAdmin(player)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	PlayerState[player] = nil
	SpinningPlayers[player] = nil
end)

