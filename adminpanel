end

local function showTab(tab)

	clearContent()

	-- MOVEMENT
	if tab == "MOVEMENT" then

		makeSection("MOVEMENT")

		makeToggle("Fly", false, setFly)

		makeToggle("Noclip", false, setNoclip)

		makeToggle("Infinite Jump", false, function(enabled)
			InfiniteJumpEnabled = enabled
		end)

		makeToggle("Speed Boost", false, setSpeed)

		makeToggle("High Jump", false, setJump)

		makeToggle("Spin", false, function(enabled)
			SpinEnabled = enabled
		end)

		makeButton("Launch", function()

			if Root then
				Root.AssemblyLinearVelocity =
					Vector3.new(0, 150, 0)
			end
		end)

		makeButton("Reset Movement", function()

			FlyEnabled = false
			NoclipEnabled = false
			InfiniteJumpEnabled = false
			SpeedEnabled = false
			HighJumpEnabled = false
			SpinEnabled = false

			if Humanoid then
				Humanoid.WalkSpeed = 16
				Humanoid.JumpPower = 50
			end

			if Root then
				Root.AssemblyLinearVelocity = Vector3.zero
			end
		end)

	-- VISUALS
	elseif tab == "VISUALS" then

		makeSection("VISUALS")

		makeToggle("Player ESP", ESPEnabled, function(enabled)

			ESPEnabled = enabled
			updateESP()
		end)

		makeToggle("Fullbright", false, setFullbright)

		makeToggle("Big Head", false, function(enabled)

			BigHeadEnabled = enabled

			if Character then

				local Head =
					Character:FindFirstChild("Head")

				if Head then

					Head.Size =
						enabled
						and Vector3.new(3, 3, 3)
						or Vector3.new(2, 1, 1)
				end
			end
		end)

		makeButton("FOV 70", function()
			workspace.CurrentCamera.FieldOfView = 70
		end)

		makeButton("FOV 90", function()
			workspace.CurrentCamera.FieldOfView = 90
		end)

		makeButton("FOV 120", function()
			workspace.CurrentCamera.FieldOfView = 120
		end)

		makeButton("Reset FOV", function()
			workspace.CurrentCamera.FieldOfView = 70
		end)

	-- PLAYER
	elseif tab == "PLAYER" then

		makeSection("PLAYER")

		makeButton("Heal", function()

			if Humanoid then
				Humanoid.Health = Humanoid.MaxHealth
			end
		end)

		makeButton("Reset Character", function()

			if Humanoid then
				Humanoid.Health = 0
			end
		end)

		makeButton("Sit", function()

			if Humanoid then
				Humanoid.Sit = true
			end
		end)

		makeButton("Stand", function()

			if Humanoid then
				Humanoid.Sit = false
			end
		end)

		makeButton("Launch Yourself", function()

			if Root then
				Root.AssemblyLinearVelocity =
					Vector3.new(0, 150, 0)
			end
		end)

	-- TARGET
	elseif tab == "TARGET" then

		makeSection("TARGET PLAYER")

		makeButton("Select Closest Player", function()

			SelectedPlayer = getClosestPlayer()

			if SelectedPlayer then
				warn(
					"[ADMIN] Selected:",
					SelectedPlayer.Name
				)
			end
		end)

		makeButton("Teleport To Target", function()

			teleportTo(
				SelectedPlayer
				or getClosestPlayer()
			)
		end)

		makeButton("Teleport To Closest", function()

			teleportTo(
				getClosestPlayer()
			)
		end)

		makeButton("Refresh Target", function()

			SelectedPlayer = getClosestPlayer()

			if SelectedPlayer then
				warn(
					"[ADMIN] Target:",
					SelectedPlayer.Name
				)
			end
		end)

	-- CAMERA
	elseif tab == "CAMERA" then

		makeSection("CAMERA")

		makeButton("FOV 70", function()
			workspace.CurrentCamera.FieldOfView = 70
		end)

		makeButton("FOV 90", function()
			workspace.CurrentCamera.FieldOfView = 90
		end)

		makeButton("FOV 120", function()
			workspace.CurrentCamera.FieldOfView = 120
		end)

		makeButton("Reset Camera", function()

			workspace.CurrentCamera.FieldOfView = 70

			if Humanoid then
				workspace.CurrentCamera.CameraSubject =
					Humanoid
			end
		end)

	-- TROLL
	elseif tab == "TROLL" then

		makeSection("FUN / TROLL")

		makeToggle("Spin", false, function(enabled)
			SpinEnabled = enabled
		end)

		makeButton("Ragdoll", function()

			if Humanoid then

				Humanoid:ChangeState(
					Enum.HumanoidStateType.Physics
				)

				task.delay(3, function()

					if Humanoid then

						Humanoid:ChangeState(
							Enum.HumanoidStateType.GettingUp
						)
					end
				end)
			end
		end)

		makeButton("Launch Yourself", function()

			if Root then
				Root.AssemblyLinearVelocity =
					Vector3.new(0, 150, 0)
			end
		end)

		makeButton("Sit", function()

			if Humanoid then
				Humanoid.Sit = true
			end
		end)

		makeButton("Stand", function()

			if Humanoid then
				Humanoid.Sit = false
			end
		end)

	-- SERVER
	elseif tab == "SERVER" then

		makeSection("SERVER")

		makeButton("Rejoin Server", function()

			game:GetService("TeleportService"):Teleport(
				game.PlaceId,
				Player
			)
		end)

		makeButton("Respawn", function()

			Player:LoadCharacter()
		end)

		makeButton("Reset Character", function()

			if Humanoid then
				Humanoid.Health = 0
			end
		end)
	end
end

